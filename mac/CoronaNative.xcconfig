// This file contains basic setup for Corona Native apps and plugins

CORONA_ROOT=$HOME/Library/Application Support/Corona/Native

// Пути поиска заголовочных файлов, включая общую папку и Opus
HEADER_SEARCH_PATHS = $(inherited) "$(CORONA_ROOT)/Corona/shared/include/Corona" "$(CORONA_ROOT)/Corona/shared/include/lua" "$(CORONA_ROOT)/Corona/ios/include/Corona" "$(SRCROOT)/../opus-1.6.1/include"

// Флаги линковщика: разрешаем неопределенные символы для Lua рантайма и линкуем статическую библиотеку Opus
OTHER_LDFLAGS = -undefined dynamic_lookup "$(SRCROOT)/libopus.a"

GCC_PREPROCESSOR_DEFINITIONS[config=Debug] = $(inherited) CORONA_DEBUG DEBUG=1
